# The frontend Dockerfile does `COPY . .` after installing dependencies,
# so exclude anything that would bloat the build context or leak config.

# Dependencies — reinstalled inside the image from package-lock.json
node_modules/

# Build output — regenerated by `npm run build` in the image
dist/

# Secrets / local config
.env
.env.*
!.env.example

# Logs & caches
*.log
npm-debug.log*
.vite/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Not needed in the image
Dockerfile
.dockerignore
