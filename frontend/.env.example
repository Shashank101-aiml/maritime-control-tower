# Copy to .env and fill in for anything other than local dev against
# localhost:8000. .env is gitignored; this template is not.

# Origin the frontend calls for the API and health check — no trailing
# slash, no /api suffix (that's appended in src/config.js).
# Falls back to http://localhost:8000 when unset.
VITE_API_BASE_URL=http://localhost:8000
