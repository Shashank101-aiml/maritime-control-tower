# Copy to .env and fill in. .env is gitignored; this template is not.

# --- Security ---------------------------------------------------------
# Generate a real one: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins allowed to call the API (comma-separated).
# Must include wherever the frontend is served from. 5173 is the Vite
# dev server; the Docker Compose frontend serves on port 80 instead, so
# a docker-compose deployment needs http://localhost (no port) too.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# Requests per minute per client IP on prediction/workflow routes.
RATE_LIMIT_PER_MINUTE=60

# --- Initial admin ----------------------------------------------------
# Seeded on first startup only, when the users table is empty.
# Change the password before exposing the service anywhere.
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin

# --- Database ---------------------------------------------------------
DATABASE_URL=sqlite:///./sql_app.db
# DATABASE_URL=postgresql://user:password@localhost:5432/maritime

# --- Live data --------------------------------------------------------
# Sea state comes from Open-Meteo and needs no key. Set false to run
# fully offline.
ENABLE_LIVE_INGESTION=true

# Free key from https://aisstream.io for live vessel positions.
# Leave blank to run without AIS; /api/vessels reports not_configured.
AISSTREAM_API_KEY=

# Optional enrichment, both skipped when unset.
WEATHER_API_KEY=
NEWS_API_KEY=
OPENAI_API_KEY=
