# Single environment file for the whole project (backend, database, frontend).
# Copy this file to .env and fill it in. .env is gitignored.
# Docker Compose reads it for both service config and ${...} substitution;
# a native backend run reads it from the repo root; Vite reads VITE_* from it.

# --- Security ---------------------------------------------------------
# Signs login tokens. Must be 32+ random characters; the app refuses to start without one.
# `python scripts/bootstrap.py` fills this in for you.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=60

# --- Initial admin (seeded on first start, when the users table is empty)
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
# 12+ characters, not a common password. No default: the app refuses to create the admin without one.
FIRST_SUPERUSER_PASSWORD=

# --- Database ---------------------------------------------------------
# Native run uses this. Docker Compose overrides it to point at the db service.
DATABASE_URL=sqlite:///./sql_app.db
POSTGRES_USER=maritime
# No default: docker compose refuses to start without one. bootstrap.py generates it.
POSTGRES_PASSWORD=

# --- External APIs ----------------------------------------------------
# Open-Meteo (sea state / wind) needs no key. false = run fully offline.
ENABLE_LIVE_INGESTION=true
# AISStream.io - live vessel positions. Blank = AIS off, /api/vessels reports not configured.
AISSTREAM_API_KEY=
# Operator fleets (optional; defaults shown). AISStream allows 50 tracked ships per key.
# FLEET_MAX_TRACKED_VESSELS=50
# FLEET_MONITOR_INTERVAL_SECONDS=300
# FLEET_POSITION_STALE_MINUTES=30
# OpenWeatherMap - current weather enrichment. Blank = skipped.
WEATHER_API_KEY=
# NewsAPI.org - maritime news ingestion. Blank = skipped.
NEWS_API_KEY=
# OilPriceAPI.com - live bunker prices for Fuel & Cost. Blank = cost is not estimated.
OIL_PRICE_API=
# OpenAI - optional LLM explanations. Blank = template-based explanations.
OPENAI_API_KEY=

# --- Frontend (only VITE_* is exposed to the browser) ------------------
# Backend origin, no trailing slash and no /api suffix.
VITE_API_BASE_URL=http://localhost:8001
